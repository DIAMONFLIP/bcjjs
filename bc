end)

-------------------------------------------------------------------------
-- REAL A/D CURVE DASH & COMBO EXECUTION
-------------------------------------------------------------------------
local function performSideCurveDashAndCombo()
    if isExecuting then return end

    if not lockedTarget then
        lockedTarget = getClosestTarget()
    end
    if not lockedTarget or not lockedTarget:FindFirstChild("HumanoidRootPart") then return end

    isExecuting = true

    if Config.BackStabDelay > 0 then
        task.wait(Config.BackStabDelay)
    end

    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local targetHRP = lockedTarget.HumanoidRootPart

    if hrp and targetHRP then
        triggerDashEffects()

        local sideDir = (math.random(1, 2) == 1 and 1 or -1)
        local sidePos = targetHRP.CFrame * CFrame.new(Config.SideDashDistance * sideDir, 0, Config.BackStabRadius * 0.5)
        local behindPos = targetHRP.CFrame * CFrame.new(0, 0, Config.BackStabRadius)

        local tween1 = TweenService:Create(hrp, TweenInfo.new(Config.BackStabSpeed * 0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            CFrame = CFrame.lookAt(sidePos.Position, targetHRP.Position)
        })
        tween1:Play()
        tween1.Completed:Wait()

        local tween2 = TweenService:Create(hrp, TweenInfo.new(Config.BackStabSpeed * 0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            CFrame = CFrame.lookAt(behindPos.Position, targetHRP.Position)
        })
        tween2:Play()
        tween2.Completed:Wait()

        hrp.CFrame = CFrame.lookAt(hrp.Position, targetHRP.Position)

        if Config.YujiFlash then
            pressKey(Enum.KeyCode.Three, 0.03)

            if Config.YujiRepeatOnCancel then
                task.wait(0.02)
                pressKey(Enum.KeyCode.Three, 0.03)
            end
        end
    end

    task.wait(0.1)
    isExecuting = false
end

-------------------------------------------------------------------------
-- INPUT CONTROLS
-------------------------------------------------------------------------
UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end

    if input.KeyCode == LOCKON_KEY then
        if lockedTarget then
            lockedTarget = nil
            pcall(function()
                game:GetService("StarterGui"):SetCore("SendNotification", { Title = "Lock-On", Text = "Unlocked", Duration = 1.2 })
            end)
        else
            lockedTarget = getClosestTarget()
            if lockedTarget then
                pcall(function()
                    game:GetService("StarterGui"):SetCore("SendNotification", { Title = "Lock-On", Text = "Target: " .. lockedTarget.Name, Duration = 1.2 })
                end)
            end
        end
    end

    if input.KeyCode == Enum.KeyCode.Three then
        performSideCurveDashAndCombo()
    end
end)


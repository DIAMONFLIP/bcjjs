-- HELPER FUNCTIONS & DASH EFFECTS
-------------------------------------------------------------------------
local function pressKey(keyCode, holdTime)
    VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
    task.wait(holdTime or 0.02)
    VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
end

local function triggerDashEffects()
    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Q, false, game)
    task.wait(0.01)
    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Q, false, game)
end

local function getClosestTarget()
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    local closest = nil
    local shortestDistance = Config.BackStabRange * 3

    for _, p in pairs(Players:GetPlayers()) do
        if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character:FindFirstChild("Humanoid") then
            if p.Character.Humanoid.Health > 0 then
                local dist = (p.Character.HumanoidRootPart.Position - char.HumanoidRootPart.Position).Magnitude
                if dist < shortestDistance then
                    shortestDistance = dist
                    closest = p.Character
                end
            end
        end
    end

    for _, v in pairs(Workspace:GetDescendants()) do
        if v:IsA("Humanoid") and v.Health > 0 and v.Parent ~= char and not Players:GetPlayerFromCharacter(v.Parent) then
            local hrp = v.Parent:FindFirstChild("HumanoidRootPart")
            if hrp then
                local dist = (hrp.Position - char.HumanoidRootPart.Position).Magnitude
                if dist < shortestDistance then
                    shortestDistance = dist
                    closest = v.Parent
                end
            end
        end
    end
    return closest
end

RunService.RenderStepped:Connect(function()
    if Config.BackStabCamera and lockedTarget and lockedTarget:FindFirstChild("HumanoidRootPart") and lockedTarget:FindFirstChild("Humanoid") and lockedTarget.Humanoid.Health > 0 then
